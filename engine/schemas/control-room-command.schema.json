{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/menqstudio/Bro/schemas/control-room-command.schema.json",
  "title": "Bro Control Room Command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "command_id",
    "task_id",
    "command",
    "requested_by_type",
    "requested_by",
    "requested_at_epoch",
    "expires_at_epoch",
    "expected_task_state",
    "scope",
    "reason",
    "evidence_refs"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "command_id": {
      "$ref": "#/$defs/id"
    },
    "task_id": {
      "$ref": "#/$defs/id"
    },
    "command": {
      "enum": [
        "approve",
        "deny",
        "cancel",
        "retry",
        "reassign",
        "request-verification"
      ]
    },
    "requested_by_type": {
      "enum": [
        "owner",
        "bro"
      ]
    },
    "requested_by": {
      "type": "string",
      "minLength": 1
    },
    "requested_at_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "expected_task_state": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifact_type": {
      "const": "control-room-command",
      "description": "Present only on a command the OWNER signed. Names the artifact type the operator root is authorised to sign for this document (see bro_signature.ARTIFACT_AUTHORITY)."
    },
    "key_id": {
      "type": "string",
      "minLength": 1,
      "description": "The operator-root key that signed it. Must be listed `active` in the operator-signed config/trusted-keys.json with `control-room-command` among its allowed_artifact_types."
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$",
      "description": "Detached Ed25519 signature over the JCS-canonical payload, lowercase hex. OPTIONAL in this schema on purpose: a conductor-issued command is proven by a separate `conductor-session` credential and carries none. What is NOT optional is the consequence -- bro_control_room_api refuses an owner command that presents no signed `control-room-command` artifact bound to this exact command_id, task_id and command."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
    }
  }
}
