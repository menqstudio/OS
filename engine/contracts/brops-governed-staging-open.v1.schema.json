{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "brops.governed-staging-open.v1"
    },
    "install_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "challenge_handle": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_nonce": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "artifact": {
      "enum": [
        "system",
        "history",
        "generation_config"
      ]
    },
    "declared_len": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8388608
    },
    "declared_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "protocol",
    "install_id",
    "challenge_handle",
    "request_nonce",
    "artifact",
    "declared_len",
    "declared_sha256"
  ]
}
