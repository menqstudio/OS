{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "bridge.governed-turn-submit.v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "challenge_doc_b64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]*$",
      "maxLength": 5462
    },
    "system": {
      "type": "string",
      "maxLength": 262144
    },
    "history": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "user",
              "assistant",
              "system"
            ]
          },
          "content": {
            "type": "string",
            "maxLength": 1048576
          }
        },
        "required": [
          "role",
          "content"
        ]
      }
    },
    "generation_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "max_output_tokens": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,6}$"
        },
        "temperature": {
          "type": "string",
          "pattern": "^[0-2]\\.[0-9]{2}$"
        },
        "top_p": {
          "type": "string",
          "pattern": "^[01]\\.[0-9]{2}$"
        }
      },
      "required": [
        "engine_id",
        "model",
        "max_output_tokens",
        "temperature",
        "top_p"
      ]
    }
  },
  "required": [
    "protocol",
    "task_id",
    "challenge_doc_b64",
    "system",
    "history",
    "generation_config"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
