      "accent": "#7c8dff",
      "accent-text": "#0c0e13",
      "success": "#4ade80",
      "warning": "#f0b23a",
      "danger": "#f2708a",
      "info": "#6cb2ff",
      "focus": "#7c8dff"
    }
  },
