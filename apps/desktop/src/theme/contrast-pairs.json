{
  "note": "Foreground/background text intents for the BroPS design tokens. The named colors MUST mirror apps/desktop/src/theme/tokens.ts (which itself mirrors tokens.css) — the same shipping palette. tools/check_contrast.py resolves every pair against BOTH the light and dark palette and fails closed if any text pair is below its WCAG AA threshold in either theme. `size` selects the threshold: `normal` text needs >= 4.5:1, `large`/bold text (>= 18.66px bold or >= 24px) needs >= 3.0:1. Update this file in the same change as any token color edit.",
  "thresholds": {
    "normal": 4.5,
    "large": 3.0
  },
  "palettes": {
    "light": {
      "bg": "#f5f6f8",
      "surface": "#ffffff",
